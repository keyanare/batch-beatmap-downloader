    "humanize-duration": "^3.35.0",
    "lucide-react": "^1.48.0",
    "rc-slider": "^11.1.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "react-select": "^5.10.2",
