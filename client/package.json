{
  "name": "batch-beatmap-downloader",
  "productName": "Batch Beatmap Downloader",
  "version": "1.4.0",
  "description": "A way to mass download osu! beatmaps with a user friendly query builder.",
  "main": ".webpack/main",
  "repository": {
    "type": "git",
    "url": "https://github.com/keyanare/batch-beatmap-downloader.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --ext .ts,.tsx",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:win": "electron-forge make --platform win32",
    "make:mac": "electron-forge make --platform darwin",
    "make:linux": "electron-forge make --platform linux",
    "publish": "electron-forge publish"
  },
  "keywords": [],
  "author": {
    "name": "nzbasic",
    "email": "jamescoppard024@gmail.com"
  },
  "license": "MIT",
  "config": {
    "forge": "./.config/forge.config.js"
  },
  "prettier": {
    "singleQuote": false
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@reforged/maker-appimage": "^5.3.1",
    "@types/humanize-duration": "^3.27.4",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "autoprefixer": "^10.6.1",
    "css-loader": "^7.1.5",
    "dotenv": "^16.6.1",
    "electron": "^44.4.5",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "node-loader": "^2.1.0",
    "postcss": "^8.5.28",
